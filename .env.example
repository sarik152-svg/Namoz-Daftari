# Postgres connection string. Railway injects this automatically for linked services.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Password for the admin panel, which can see and reset every PIN.
# At least 8 characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_PASSWORD=change-me

# Key used to encrypt PINs at rest. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes every existing PIN unreadable, so the admin must reset them all.
PIN_ENCRYPTION_KEY=change-me

# Optional. Bootstraps these members on a FRESH database only, each with a random
# PIN the admin reads off the roster. Ignored once any member exists.
# Format: id:Name:City:lat:lng:tz:asr:fajr_angle:isha_angle
SEED_MEMBERS=sardor:Sardor Valixanov:Toshkent:41.2995:69.2401:5:2:18:18|behruz:Behruz Qurbonov:Dubay:25.2048:55.2708:4:1:18.2:18.2
